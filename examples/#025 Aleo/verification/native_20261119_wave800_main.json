      "sha256": "72a6f679a04c7cb477c2fe4a8b1d438ab1a8b30004c6cff832304576e824edc8",
      "content_utf8": "use rand::rng;\nuse snarkvm::circuit::AleoV0;\nuse snarkvm::prelude::{MainnetV0, PrivateKey, Process, Program, Value};\nuse std::error::Error;\nuse std::fs;\n\nfn main() -> Result<(), Box<dyn Error>> {\n    let bytes = fs::read_to_string(\"hello.aleo\")?;\n    let program: Program<MainnetV0> = bytes.parse()?;\n    let process = Process::<MainnetV0>::load()?;\n    process.lock().add_program(&program)?;\n    let mut randomness = rng();\n    let private_key = PrivateKey::new(&mut randomness)?;\n    let authorization = process.authorize::<AleoV0, _>(\n        &private_key, program.id(), \"greeting\", Vec::<Value<MainnetV0>>::new().into_iter(), &mut randomness,\n    )?;\n    let response = process.evaluate::<AleoV0>(authorization)?;\n    for output in response.outputs() {\n        println!(\"Output: {output}\");\n    }\n    Ok(())\n}\n"
    }
  },
