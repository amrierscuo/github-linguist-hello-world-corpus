      "content_utf8": "import java.io.File;\nimport java.nio.charset.StandardCharsets;\nimport wyc.Compiler;\nimport wycc.util.Trie;\nimport wyil.interpreter.Interpreter;\nimport wyil.interpreter.ConcreteSemantics.RValue;\nimport wyil.lang.WyilFile;\npublic class Check {\n    public static void main(String[] args) throws Exception {\n        File root=new File(\".\");\n        Trie src=Trie.fromString(\"hello\");\n        Compiler compiler=new Compiler().setWhileyDir(root).setWyilDir(root).setTarget(src).addSource(src);\n        if(!compiler.run()) throw new IllegalStateException(\"Whiley compilation failed\");\n        WyilFile program=Compiler.readWyilFile(root,src);\n        Interpreter interp=new Interpreter(System.out,program);\n        WyilFile.Type.Function type=new WyilFile.Type.Function(new WyilFile.Type.Void(),new WyilFile.Type.Array(new WyilFile.Type.Int()));\n        var id=WyilFile.QualifiedName.fromString(\"hello::greeting\");\n        var value=(RValue.Array)interp.execute(id,type,interp.new CallStack());\n        byte[] greeting=value.toByteArray();\n        if(greeting.length!=13) throw new IllegalStateException(value.toString());\n        System.out.println(new String(greeting,StandardCharsets.US_ASCII));\n    }\n}\n"
    }
