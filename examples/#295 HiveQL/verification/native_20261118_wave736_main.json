      "content_utf8": "import org.apache.hadoop.hive.conf.HiveConf;\nimport org.apache.hadoop.hive.ql.Driver;\nimport org.apache.hadoop.hive.ql.session.SessionState;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.util.ArrayList;\n\npublic class RunHive {\n public static void main(String[] args) throws Exception {\n   var config=new HiveConf();\n   config.set(\"fs.defaultFS\",\"file:///\");\n   config.set(\"hive.metastore.warehouse.dir\",Path.of(\"warehouse\").toAbsolutePath().toString());\n   config.set(\"javax.jdo.option.ConnectionURL\",\"jdbc:derby:memory:corpus;create=true\");\n   config.set(\"hive.metastore.schema.verification\",\"false\");\n   config.set(\"datanucleus.schema.autoCreateAll\",\"true\");\n   config.set(\"hive.exec.mode.local.auto\",\"true\");\n   config.set(\"hive.jar.directory\",Path.of(\"hivejars\").toAbsolutePath().toString());\n   config.set(\"hive.user.install.directory\",Path.of(\"hivejars\").toAbsolutePath().toString());\n   config.set(\"hive.execution.engine\",\"mr\");\n   Files.createDirectories(Path.of(\"hivejars\"));\n   config.set(\"hive.exec.scratchdir\",Path.of(\"hivescratch\").toAbsolutePath().toString());\n   config.set(\"hive.exec.local.scratchdir\",Path.of(\"hinternal\").toAbsolutePath().toString());\n   var active=SessionState.start(config);\n   try(var driver=new Driver(config)) {\n     driver.run(Files.readString(Path.of(\"hello.hql\")).strip().replaceFirst(\";$\",\"\"));\n     var rows=new ArrayList<String>();\n     driver.getResults(rows);\n     if(!rows.equals(java.util.List.of(\"Hello, World!\"))) throw new AssertionError(rows);\n     System.out.println(rows.get(0));\n   } finally { active.close(); }\n }\n}\n"
    }
