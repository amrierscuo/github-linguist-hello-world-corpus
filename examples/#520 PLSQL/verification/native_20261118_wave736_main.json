      "sha256": "8c28893bc8aeda481d6cd23ab507c9d29ddd1624d7fac9206dc496ae87420270",
      "content_utf8": "CREATE DATABASE corpus;\nUSE corpus;\nSET sql_mode=ORACLE;\nDELIMITER /\nCREATE PACKAGE DBMS_OUTPUT AS\n   PROCEDURE PUT_LINE(msg VARCHAR2(32767));\nEND;\n/\nCREATE PACKAGE BODY DBMS_OUTPUT AS\n   PROCEDURE PUT_LINE(msg VARCHAR2(32767)) AS\n   BEGIN\n       SET @corpus_output = msg;\n   END;\nEND;\n/\nBEGIN\n  DBMS_OUTPUT.PUT_LINE('Hello, World!');\nEND;\n/\nDELIMITER ;\nSELECT @corpus_output;\n"
    },
    "run.sh": {
      "sha256": "a20686d58961206da2ab382f66b70d4e940569307054d62423a7d1477379d8e1",
      "content_utf8": "#!/bin/bash\nset -eu\nexport USER=root TMPDIR=/tmp\ns=/work/runtime-db.sock\nmkdir /work/database\nmariadb-install-db --user=root --datadir=/work/database --skip-test-db --skip-name-resolve --force --auth-root-authentication-method=normal >bootstrap.log 2>&1 || { cat bootstrap.log; exit 4; }\nmariadbd --user=root --datadir=/work/database --skip-networking --socket=\"$s\" --pid-file=/work/db.pid >engine.log 2>&1 &\np=$!\ntrap 'kill \"$p\" 2>/dev/null || true;wait \"$p\" 2>/dev/null || true' EXIT\nfor n in $(seq 1 70); do\n if mariadb-admin --no-defaults --socket=\"$s\" -uroot ping >/dev/null 2>&1; then\n   mariadb --no-defaults --socket=\"$s\" -uroot --batch --skip-column-names <sql-check.sql\n   exit 0\n fi\n kill -0 \"$p\" || { cat engine.log; exit 2; }\n sleep 0.3\ndone\ncat engine.log\nexit 3\n"
