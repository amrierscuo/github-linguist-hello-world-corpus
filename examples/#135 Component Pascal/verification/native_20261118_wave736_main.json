      "content_utf8": "import struct\nimport zipfile\nfrom pathlib import Path\n\ndef normalize_class_names(original,destination):\n    total=0\n    with zipfile.ZipFile(original) as source,zipfile.ZipFile(destination,'w') as target:\n        for item in source.infolist():\n            blob=source.read(item)\n            if item.filename.endswith('.class'):\n                blob,normalized=normalize_class(blob)\n                total+=normalized\n            target.writestr(item,blob)\n    return total\n\ndef normalize_class(source):\n    assert source.startswith(b'\\xca\\xfe\\xba\\xbe')\n    u16=struct.Struct('>H')\n    offset=10\n    end=u16.unpack_from(source,8)[0]\n    vals={}\n    class_refs={}\n    index=1\n    sizes={3:4,4:4,5:8,6:8,7:2,8:2,9:4,10:4,11:4,12:4,15:3,16:2,17:4,18:4,19:2,20:2}\n    while index<end:\n        tag=source[offset]\n        offset+=1\n        if tag==1:\n            n=u16.unpack_from(source,offset)[0]\n            offset+=2\n            vals[index]=source[offset:offset+n]\n            offset+=n\n        else:\n            if tag==7:\n                class_refs[offset]=u16.unpack_from(source,offset)[0]\n            offset+=sizes[tag]\n        index+=2 if tag in (5,6) else 1\n    corrected=bytearray(source[:offset])\n    new=[]\n    for start,ref in class_refs.items():\n        data=vals[ref]\n        if not(data.startswith(b'L') and b'/' in data and data.endswith(b';')):continue\n        value=data[1:-1]\n        corrected[start:start+2]=u16.pack(end+len(new))\n        new.append(b'\\x01'+u16.pack(len(value))+value)\n    corrected[8:10]=u16.pack(end+len(new))\n    corrected.extend(b''.join(new))\n    corrected.extend(source[offset:])\n    return bytes(corrected),len(new)\n\n"
    },
