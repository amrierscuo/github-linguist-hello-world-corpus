      "content_utf8": "from importlib.metadata import version\nfrom wasmtime import Engine, Store\nfrom wasmtime.component import Component, Linker\nengine=Engine()\nstore=Store(engine)\ncomponent=Component.from_file(engine,\"greet.wasm\")\nlinker=Linker(engine)\ninstance=linker.instantiate(store,component)\nindex=component.get_export_index(\"corpus:greeting/greeter\")\nassert index is not None\nfunc_index=component.get_export_index(\"greet\",index)\nassert func_index is not None\nfunc=instance.get_func(store,func_index)\nassert func is not None\nfor name in (\"World\",\"Reader\"):\n    print(func(store,name))\n    func.post_return(store)\nprint(version(\"wasmtime\"))\n"
