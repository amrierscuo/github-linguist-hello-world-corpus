; Hello World as a minimal standalone SELinux CIL policy.
; The example is compiled to scratch files, never loaded into the host policy.
(handleunknown deny)
(mls false)
(class file (read))
(classorder (file))
(sid kernel)
(sidorder (kernel))
(sensitivity s0)
(sensitivityorder (s0))
(level low (s0))
(levelrange low_low (low low))
(role object_r)
(user hello_user)
(role hello_role)
(type hello_world_t)
(type greeting_file_t)
(userrole hello_user hello_role)
(userlevel hello_user low)
(userrange hello_user low_low)
(roletype hello_role hello_world_t)
(roletype object_r greeting_file_t)
(context hello_context (hello_user hello_role hello_world_t low_low))
(sidcontext kernel hello_context)
(allow hello_world_t greeting_file_t (file (read)))
