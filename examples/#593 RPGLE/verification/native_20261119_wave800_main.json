      "content_utf8": "import java.io.*;\nimport java.util.*;\nimport com.smeup.rpgparser.execution.RunnerKt;\nimport com.smeup.rpgparser.interpreter.SimpleSystemInterface;\nimport com.smeup.rpgparser.rpginterop.DirRpgProgramFinder;\n\npublic class RunRpg {\n    public static void main(String[] args) {\n        var finders = List.of(new DirRpgProgramFinder(new File(args[0])));\n        var system = new SimpleSystemInterface(new Properties(), finders, System.out);\n        if (system.findProgram(\"hello\") == null) throw new AssertionError(\"Entry unavailable\");\n        var program = RunnerKt.getProgram(\"hello\", system, finders);\n        program.singleCall(List.<String>of());\n    }\n}\n"
