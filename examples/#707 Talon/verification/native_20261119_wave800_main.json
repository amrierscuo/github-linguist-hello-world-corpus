    "evaluate.py": {
      "sha256": "01f567cd1c0b2372ed13a1b1069b542830b27ed3ead79b884deff293ce1dc281",
      "content_utf8": "import ast\nimport ctypes\nfrom pathlib import Path\nfrom tree_sitter import Language, Parser\nprogram=Path(\"hello.talon\").read_bytes()\nlib=ctypes.CDLL(str(Path(\"libtalon.so\").resolve()))\nlib.tree_sitter_talon.restype=ctypes.c_void_p\ncapsule=ctypes.pythonapi.PyCapsule_New\ncapsule.argtypes=[ctypes.c_void_p,ctypes.c_char_p,ctypes.c_void_p]\ncapsule.restype=ctypes.py_object\np=Parser(Language(capsule(lib.tree_sitter_talon(),b\"tree_sitter.Language\",None)))\nroot=p.parse(program).root_node\nassert not root.has_error, str(root)\nprint(\"Parsed Talon command:\",root)\ndef children(n):\n    yield n\n    for c in n.named_children:\n        yield from children(c)\ndef span(n):\n    return program[n.start_byte:n.end_byte].decode()\ncommands=[n for n in children(root) if n.type in (\"command\",\"command_declaration\")]\nassert len(commands)==1,[n.type for n in children(root)]\nc=commands[0]\nrule=c.child_by_field_name(\"left\")\nif rule is None:\n    rule=next(n for n in c.named_children if \"rule\" in n.type)\nwords=span(rule).split()\nassert words==[\"hello\",\"world\"],words\ncalls=[n for n in children(c.child_by_field_name(\"right\")) if n.type==\"action\"]\nassert len(calls)==1,[(n.type,span(n)) for n in calls]\ncall=calls[0]\nassert span(call.child_by_field_name(\"action_name\"))==\"insert\"\nargs=[n for n in children(call) if n.type in (\"string\",\"string_literal\")]\nassert len(args)==1,[n.type for n in children(call)]\npayload=ast.literal_eval(span(args[0]))\nassert payload==\"Hello, World!\",repr(payload)\nprint(\"Recognized rule:\",' '.join(words))\nprint(\"Insert payload:\",payload)\n"
    }
