(kicad_pcb (version 20221018) (generator "corpus_example")
  (general (thickness 1.6))
  (paper "A4")
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (37 "F.SilkS" user "f.silkscreen")
    (44 "Edge.Cuts" user)
  )
  (setup (pad_to_mask_clearance 0))
  (net 0 "")
  (gr_text "Hello, World!" (at 50 50) (layer "F.SilkS")
    (effects (font (size 1.5 1.5) (thickness 0.3))))
  (gr_rect (start 35 40) (end 65 60)
    (stroke (width 0.1) (type default)) (fill none) (layer "Edge.Cuts"))
)
