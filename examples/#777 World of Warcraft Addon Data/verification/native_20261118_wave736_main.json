      "sha256": "6eab606868147b17ba04c3b621d3c5bcdcd5742d259b316183347723ed9a1844",
      "content_utf8": "const fs=require(\"node:fs\"),path=require(\"node:path\");\nconst {build}=require(\"esbuild\");\nbuild({entryPoints:[\"check.ts\"],bundle:true,platform:\"node\",format:\"cjs\",packages:\"external\",outfile:\"check.cjs\",plugins:[{\n  name:\"upstream-vite-imports\",\n  setup(b){\n   b.onResolve({filter:/\\.(?:lua\\?raw|wasm\\?url)$/},a=>({path:a.path.endsWith(\"?url\")?require.resolve(\"wasmoon/dist/glue.wasm\"):path.resolve(a.resolveDir,a.path.slice(0,-4)),namespace:\"data\"}));\n   b.onLoad({filter:/.*/,namespace:\"data\"},a=>({contents:\"export default \"+JSON.stringify(a.path.endsWith(\".wasm\")?a.path:fs.readFileSync(a.path,\"utf8\")),loader:\"js\"}));\n  }\n}]}).catch(error=>{console.error(error);process.exitCode=1;});\n"
