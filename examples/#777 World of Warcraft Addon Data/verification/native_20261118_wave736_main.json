      "content_utf8": "import fs from \"node:fs\";\nimport assert from \"node:assert/strict\";\nimport {loadFromFiles,textFile} from \"./src/addons\";\nimport {Runtime} from \"./src/runtime\";\nasync function main() {\n    const files=[\"Greeting.toc\",\"Greeting.lua\"].map(p=>textFile(p,fs.readFileSync(\"../\"+p,\"utf8\")));\n    const addons=await loadFromFiles(\"Greeting\",files);\n    assert.equal(addons.length,1);\n    assert.equal(addons[0].name,\"Greeting\");\n    const messages:string[]=[];\n    const runtime=new Runtime({log(kind,text){if(kind===\"error\") throw Error(text);if(kind===\"chat\")messages.push(text);},requestReload(){throw Error(\"Unexpected reload\");}});\n    await runtime.boot(addons,{w:800,h:600,sv:{}});\n    assert.deepEqual(messages,[\"Hello, World!\"]);\n    console.log(messages[0]);\n    if(typeof (runtime as any).close===\"function\")(runtime as any).close();\n}\nmain().catch(error=>{console.error(error);process.exitCode=1});\n"
    },
