      "content_utf8": "use mirage_engine::{client::load_script, cmd, eval};\n\nfn main() -> std::io::Result<()> {\n    let input = std::env::args().nth(1).expect(\"script filename\");\n    let source = std::fs::read_to_string(input)?;\n    let mut context = eval::Ctx::default();\n    load_script(&source, &mut context);\n    let body = context.aliases.get(\"hello\").expect(\"hello alias\").clone();\n    cmd::call_alias(&body, Vec::new(), &mut context);\n    assert_eq!(context.out.len(), 1, \"one output line\");\n    let result = &context.out[0];\n    assert_eq!(result.kind, \"echo\");\n    println!(\"{}\", result.text);\n    Ok(())\n}\n"
    }
