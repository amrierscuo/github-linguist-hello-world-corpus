<?xml version="1.0" encoding="UTF-8"?>
<faces-config>
  <faces-config-extension>
    <namespace-uri>urn:corpus:greeting</namespace-uri>
    <default-prefix>corpus</default-prefix>
  </faces-config-extension>
  <composite-component>
    <component-type>Greeting</component-type>
    <composite-name>Greeting</composite-name>
    <composite-file>/Greeting.xsp</composite-file>
    <composite-extension><tag-name>greeting</tag-name></composite-extension>
  </composite-component>
</faces-config>
