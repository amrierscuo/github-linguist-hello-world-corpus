collections {
  group {
    name: "greeting";
    parts {
      part {
        name: "label";
        type: TEXT;
        description {
          state: "default" 0.0;
          text {
            text: "Hello, World!";
            font: "Sans";
            size: 24;
            align: 0.5 0.5;
          }
        }
      }
    }
  }
}
