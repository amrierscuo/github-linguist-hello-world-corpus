  "fixture_sha256": {
    "image-transport-policy.json": {
      "sha256": "cde3a9b4e1f004c30f02144f68bcc6d8019f5522e60b9daf25d370a940f06ef2",
      "content_utf8": "{\"default\":[{\"type\":\"insecureAcceptAnything\"}]}\n"
    },
    "run_switch.py": {
      "sha256": "e5c60e814d6d233e56e2638aa468238f90e0c751f4d0d5bb21f8ec763484a32e",
      "content_utf8": "from pathlib import Path\nimport struct\nimport subprocess\nimport time\n\ndef read_packets(path):\n    if not path.is_file():return []\n    data=path.read_bytes()\n    if len(data)<24:return []\n    first=data[:4]\n    endian=\"<\" if first in (b\"\\xd4\\xc3\\xb2\\xa1\",b\"M<\\xb2\\xa1\") else \">\"\n    offset=24\n    out=[]\n    while offset+16<=len(data):\n        size=struct.unpack_from(endian+\"IIII\",data,offset)[2]\n        start=offset+16\n        if start+size>len(data):break\n        out.append(data[start:start+size])\n        offset=start+size\n    return out\n\nargs=[\"/usr/local/bin/simple_switch\",\"--use-files\",\"0\",\"-i\",\"0@port0\",\"-i\",\"1@port1\",\"hello.json\"]\nproc=subprocess.Popen(args, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)\nobserved=[]\ntry:\n    for _ in range(95):\n        observed=read_packets(Path(\"port1_out.pcap\"))\n        if observed or proc.poll() is not None: break\n        time.sleep(0.1)\nfinally:\n    if proc.poll() is None: proc.terminate()\n    try: out,_=proc.communicate(timeout=4)\n    except subprocess.TimeoutExpired:\n        proc.kill()\n        out,_=proc.communicate()\nprint(out.decode(errors=\"replace\"),end=\"\")\nassert observed, \"BMv2 did not emit a packet on port 1\"\nassert not read_packets(Path(\"port0_out.pcap\")), \"Unexpected packet on port 0\"\nprint(\"Output frames:\", [packet.hex() for packet in observed])\nprint(\"Port 1 greeting:\", observed[0][:13].decode(\"ascii\"))\nassert len(observed)==1\n"
    }
  },
