      "content_utf8": "import java.io.*;\nimport java.nio.charset.StandardCharsets;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport com.fasterxml.jackson.core.JsonFactory;\nimport com.yahoo.document.DataType;\nimport com.yahoo.document.DocumentPut;\nimport com.yahoo.document.DocumentTypeManager;\nimport com.yahoo.document.json.JsonReader;\nimport com.yahoo.schema.ApplicationBuilder;\n\npublic class ReadSchema {\n    public static void main(String[] args) throws Exception {\n        var schema = ApplicationBuilder.createFromFile(\"hello.sd\").getSchema(\"hello\");\n        var message = schema.getDocumentField(\"message\");\n        if (message.getDataType() != DataType.STRING || !message.doesIndexing() || !message.doesSummarying()) {\n            throw new IllegalStateException(\"Unexpected field type or indexing\");\n        }\n        var types = new DocumentTypeManager();\n        types.registerDocumentType(schema.getDocument().getDocumentType());\n        var bytes = (\"[\" + Files.readString(Path.of(\"document.json\")) + \"]\").getBytes(StandardCharsets.UTF_8);\n        var reader = new JsonReader(types, new ByteArrayInputStream(bytes), new JsonFactory());\n        var put = (DocumentPut) reader.next();\n        var doc = put.getDocument();\n        if (!doc.getId().toString().equals(\"id:corpus:hello::greeting\")) {\n            throw new IllegalStateException(\"Original document identity was changed\");\n        }\n        System.out.println(\"Typed field: \" + doc.getFieldValue(\"message\"));\n    }\n}\n"
    }
