# Preserve byte-identical references, language artifacts and recorded hashes.
# https://git-scm.com/docs/gitattributes (text attribute: Unset)
* -text

# Repository language statistics focus on the language examples.
# https://github.com/github-linguist/linguist/blob/main/docs/overrides.md#detectable
# These source samples are the repository's code, rather than documentation.
# Linguist otherwise excludes examples/ by its default documentation rules.
/examples/** linguist-documentation=false
/index.html linguist-detectable=false
/tools/** linguist-detectable=false
/reference/** linguist-detectable=false
/tracking/** linguist-detectable=false
/icons/** linguist-detectable=false
/LICENSES/** linguist-detectable=false
/README.md linguist-detectable=false
/AGENTS.md linguist-detectable=false
/docs/** linguist-detectable=false
/SHA256SUMS.txt linguist-detectable=false
/site/** linguist-detectable=false
/.github/** linguist-detectable=false
/LICENSE linguist-detectable=false
/examples/**/README.md linguist-detectable=false
/examples/**/verification/** linguist-detectable=false
/examples/**/verification.log linguist-detectable=false
/examples/**/verify.* linguist-detectable=false
/examples/**/verify_* linguist-detectable=false
/examples/**/Verify.* linguist-detectable=false
/examples/**/VerifyHost.cs linguist-detectable=false
/examples/**/VerifyManifest.java linguist-detectable=false
/examples/**/desktop.ini linguist-detectable=false

# Keep experiment documentation and check receipts out of byte statistics.
/experiments/lean-share/README.md linguist-detectable=false
/experiments/lean-share/experiment.json linguist-detectable=false
/experiments/lean-share/verification/** linguist-detectable=false

/examples/**/generate.cjs linguist-detectable=false

/examples/**/make-sj.cjs linguist-detectable=false

"/examples/#229 GDShader/check_shader.gd" linguist-detectable=false

# This genuine B4J module has no IDE export header for the ambiguous .bas suffix.
"/examples/#051 B4X/Main.bas" linguist-language=B4X
